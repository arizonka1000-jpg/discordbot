# ==========================================
# KONFIGURACJA BOTA DISCORD INSTALING
# ==========================================

# 1. Twój Token bota Discord (pobrany z https://discord.com/developers/applications)
DISCORD_TOKEN=

# 2. Baza danych Firebase Realtime Database
FIREBASE_DATABASE_URL=https://instaling-bot-2362a-default-rtdb.europe-west1.firebasedatabase.app

# 3. Tryb przeglądarki (True = ukryta w tle, False = widoczne okno)
HEADLESS=False

# 4. Godziny automatycznych codziennych sesji (w godzinach 16:00 - 23:00)
AUTO_WINDOW_START_HOUR=16
AUTO_WINDOW_END_HOUR=23
AUTO_CRON_HOURS=16,18,20,22
AUTO_CRON_MINUTE=30
DEFAULT_AUTO_HOUR=16
DEFAULT_AUTO_MINUTE=30

# 5. Ograniczenie do 1 rangi (tylko użytkownicy z tą rolą mogą używać bota)
REQUIRED_ROLE_NAME=
REQUIRED_ROLE_ID=1551679005462237304

